@page
@model Inventario.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Gestión de Inventario</h3>
        <p class="text-muted small mb-0">Administra los productos, lotes y existencias en bodegas</p>
    </div>
    <button class="btn btn-primary px-3 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalCrear">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
    </button>
</div>

<!-- Tarjetas de Métricas -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-kpi bg-white shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small">Total Registros</span>
                    <h4 class="fw-bold mb-0">@Model.InventarioList.Count</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-kpi bg-white shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-success-subtle text-success p-3 me-3">
                    <i class="bi bi-layers fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small">Unidades en Stock</span>
                    <h4 class="fw-bold mb-0">@Model.InventarioList.Sum(x => x.Cantidad)</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-kpi bg-white shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-warning-subtle text-warning p-3 me-3">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small">Valor Total</span>
                    <h4 class="fw-bold mb-0">$@Model.InventarioList.Sum(x => x.Cantidad * x.Precio).ToString("N2")</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla Principal -->
<div class="card table-custom shadow-sm border-0">
    <div class="card-header bg-white py-3 border-0">
        <div class="input-group search-box" style="max-width: 300px;">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" id="filtroTabla" class="form-control bg-light border-start-0" placeholder="Buscar producto o bodega...">
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tablaProductos">
            <thead class="table-light">
                <tr>
                    <th>Producto</th>
                    <th>Bodega</th>
                    <th>Lote</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.InventarioList)
                {
                    <tr>
                        <td class="fw-semibold">@item.NombreProducto</td>
                        <td><span class="badge bg-secondary-subtle text-secondary border">@item.CodigoBodega</span></td>
                        <td><code>@item.Lote</code></td>
                        <td>
                            @if (item.Cantidad < 10)
                            {
                                <span class="badge bg-danger-subtle text-danger"><i class="bi bi-exclamation-triangle me-1"></i>@item.Cantidad</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">@item.Cantidad</span>
                            }
                        </td>
                        <td class="fw-bold">$@item.Precio.ToString("N2")</td>
                        <td class="text-end">
                            <button class="btn btn-light btn-sm text-primary me-1" data-bs-toggle="modal" data-bs-target="#modalEditar"
                                    onclick="cargarDatosModal('@item.Id', '@item.NombreProducto', '@item.CodigoBodega', '@item.Lote', '@item.Cantidad', '@item.Precio')">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                <button type="submit" class="btn btn-light btn-sm text-danger" onclick="return confirm('¿Eliminar este registro?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Nuevo Producto</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre del Producto</label>
                        <input asp-for="ItemForm.NombreProducto" class="form-control" placeholder="Ej. Monitor 24 Pulgadas" required />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Código/Nombre Bodega</label>
                            <input asp-for="ItemForm.CodigoBodega" class="form-control" placeholder="BOD-01" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">N° Lote</label>
                            <input asp-for="ItemForm.Lote" class="form-control" placeholder="LT-2024" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Cantidad</label>
                            <input asp-for="ItemForm.Cantidad" type="number" class="form-control" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Precio Unitario ($)</label>
                            <input asp-for="ItemForm.Precio" type="number" step="0.01" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Guardar Registro</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" id="Edit_Id" asp-for="ItemForm.Id" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre del Producto</label>
                        <input id="Edit_NombreProducto" asp-for="ItemForm.NombreProducto" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Código Bodega</label>
                            <input id="Edit_CodigoBodega" asp-for="ItemForm.CodigoBodega" class="form-control" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">N° Lote</label>
                            <input id="Edit_Lote" asp-for="ItemForm.Lote" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Cantidad</label>
                            <input id="Edit_Cantidad" asp-for="ItemForm.Cantidad" type="number" class="form-control" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Precio Unitario ($)</label>
                            <input id="Edit_Precio" asp-for="ItemForm.Precio" type="number" step="0.01" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning px-4 rounded-3">Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cargarDatosModal(id, nombre, bodega, lote, cantidad, precio) {
            document.getElementById('Edit_Id').value = id;
            document.getElementById('Edit_NombreProducto').value = nombre;
            document.getElementById('Edit_CodigoBodega').value = bodega;
            document.getElementById('Edit_Lote').value = lote;
            document.getElementById('Edit_Cantidad').value = cantidad;
            document.getElementById('Edit_Precio').value = precio;
        }

        document.getElementById('filtroTabla').addEventListener('keyup', function() {
            let valor = this.value.toLowerCase();
            let filas = document.querySelectorAll('#tablaProductos tbody tr');
            filas.forEach(fila => {
                let texto = fila.textContent.toLowerCase();
                fila.style.display = texto.includes(valor) ? '' : 'none';
            });
        });
    </script>
}