<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Inventario</title>
    
    <!-- Librerías Externas -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Hoja de Estilos Personalizada -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    }

    <!-- Sidebar / Menú Lateral -->
    <aside class="sidebar d-flex flex-column">
        <div class="px-4 py-3 mb-3 text-white fw-bold fs-5 d-flex align-items-center border-bottom border-secondary">
            <i class="bi bi-box-seam text-primary fs-3 me-2"></i> 
            <span>InventarioPro</span>
        </div>

        <ul class="nav flex-column mb-auto px-2">
            <li class="nav-item mb-1">
                <a class="nav-link rounded-3 @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">
                    <i class="bi bi-house-door me-2"></i> Inicio
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link rounded-3 @(currentPage.StartsWith("/Productos") ? "active" : "")" asp-page="/Productos/Index">
                    <i class="bi bi-card-checklist me-2"></i> Productos y Stock
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link rounded-3 @(currentPage.StartsWith("/Lotes") ? "active" : "")" asp-page="/Lotes/Index">
                    <i class="bi bi-calendar-event me-2"></i> Lotes y Caducidad
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link rounded-3 @(currentPage.StartsWith("/Facturacion") ? "active" : "")" asp-page="/Facturacion/Index">
                    <i class="bi bi-receipt me-2"></i> Facturación / Ventas
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link rounded-3 @(currentPage.StartsWith("/Bodegas") ? "active" : "")" asp-page="/Bodegas/Index">
                    <i class="bi bi-building me-2"></i> Bodegas
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link rounded-3 @(currentPage.StartsWith("/Categorias") ? "active" : "")" asp-page="/Categorias/Index">
                    <i class="bi bi-tags me-2"></i> Categorías
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link rounded-3 @(currentPage.StartsWith("/Reportes") ? "active" : "")" asp-page="/Reportes/Index">
                    <i class="bi bi-graph-up-arrow me-2"></i> Reportes
                </a>
            </li>
        </ul>

        <div class="p-3 text-muted border-top border-secondary text-center small">
            v1.0 &bull; Panel de Control
        </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main class="main-content">
        <!-- Encabezado Superior -->
        <header class="bg-white border-bottom py-2 px-4 mb-4 d-flex justify-content-between align-items-center rounded-3 shadow-sm">
            <h5 class="fw-bold mb-0 text-secondary">@ViewData["Title"]</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">
                    <i class="bi bi-person-circle me-1"></i> Administrador
                </span>
            </div>
        </header>

        <!-- Contenido de cada vista Razor -->
        <div class="container-fluid px-0">
            @RenderBody()
        </div>
    </main>

    <!-- Scripts de Bootstrap y secciones de script personalizadas -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 