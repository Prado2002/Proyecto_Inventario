@page
@model Inventario.Web.Pages.Categorias.IndexModel
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Categorías de Productos</h3>
        <p class="text-muted small mb-0">Organiza y clasifica tus productos</p>
    </div>
    <button class="btn btn-primary px-3 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
        <i class="bi bi-plus-lg me-1"></i> Nueva Categoría
    </button>
</div>

<div class="card table-custom shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Total Productos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.CategoriasList.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No hay categorías registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cat in Model.CategoriasList)
                    {
                        <tr>
                            <td class="fw-bold">@cat.Nombre</td>
                            <td class="text-muted">@cat.Descripcion</td>
                            <td><span class="badge bg-info text-dark">@cat.TotalProductos productos</span></td>
                            <td class="text-end">
                                <button class="btn btn-light btn-sm text-primary me-1" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modalEditarCategoria-@cat.CategoriaID">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@cat.CategoriaID" class="d-inline">
                                    <button type="submit" class="btn btn-light btn-sm text-danger" onclick="return confirm('¿Eliminar esta categoría?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>

                        <!-- Modal Editar Categoría -->
                        <div class="modal fade" id="modalEditarCategoria-@cat.CategoriaID" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow">
                                    <form method="post" asp-page-handler="Edit">
                                        <input type="hidden" asp-for="CategoriaForm.CategoriaID" value="@cat.CategoriaID" />
                                        <div class="modal-header bg-primary text-white">
                                            <h5 class="modal-title fw-bold">Editar Categoría</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Nombre</label>
                                                <input name="CategoriaForm.Nombre" value="@cat.Nombre" class="form-control" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Descripción</label>
                                                <textarea name="CategoriaForm.Descripcion" class="form-control" rows="3">@cat.Descripcion</textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light border-0">
                                            <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-primary px-4 rounded-3">Actualizar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear Categoría -->
<div class="modal fade" id="modalCrearCategoria" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Nueva Categoría</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre</label>
                        <input asp-for="CategoriaForm.Nombre" class="form-control" placeholder="Ej. Analgésicos, Bebidas" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Descripción</label>
                        <textarea asp-for="CategoriaForm.Descripcion" class="form-control" rows="3" placeholder="Descripción breve"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>