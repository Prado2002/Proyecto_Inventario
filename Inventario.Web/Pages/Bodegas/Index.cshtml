@page
@model Inventario.Web.Pages.Bodegas.IndexModel
@{
    ViewData["Title"] = "Gestión de Bodegas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Gestión de Bodegas</h3>
        <p class="text-muted small mb-0">Administra las ubicaciones y depósitos de inventario</p>
    </div>
    <button class="btn btn-primary px-3 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalBodega">
        <i class="bi bi-plus-lg me-1"></i> Nueva Bodega
    </button>
</div>

<div class="card table-custom shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Nombre de Bodega</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.BodegasList)
                {
                    <tr>
                        <td class="fw-bold">@item.BodegaID</td>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.BodegaID" class="d-inline">
                                <button type="submit" class="btn btn-light btn-sm text-danger" onclick="return confirm('¿Eliminar esta bodega?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear Bodega -->
<div class="modal fade" id="modalBodega" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-building me-2"></i>Nueva Bodega</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre de la Bodega</label>
                        <input asp-for="BodegaForm.Nombre" class="form-control" placeholder="Ej. Bodega Principal" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Guardar Bodega</button>
                </div>
            </form>
        </div>
    </div>
</div>