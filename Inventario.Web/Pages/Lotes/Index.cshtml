@page
@model Inventario.Web.Pages.Lotes.IndexModel
@{
    ViewData["Title"] = "Gestión de Lotes y Vencimientos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Lotes y Vencimientos</h3>
        <p class="text-muted small mb-0">Control de caducidad y fechas de expiración de insumos</p>
    </div>
    <button class="btn btn-primary px-3 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalCrearLote">
        <i class="bi bi-plus-lg me-1"></i> Registrar Nuevo Lote
    </button>
</div>

<div class="card table-custom shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nº Lote</th>
                    <th>Producto</th>
                    <th>SKU</th>
                    <th>Costo Unitario</th>
                    <th>Fecha Vencimiento</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.LotesList.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No hay lotes registrados actualmente.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var lote in Model.LotesList)
                    {
                        var diasRestantes = (lote.FechaVencimiento - DateTime.Now).Days;
                        <tr>
                            <td class="fw-bold"><code>@lote.NumeroLote</code></td>
                            <td>@lote.ProductoNombre</td>
                            <td><span class="badge bg-light text-dark border">@lote.CodigoSKU</span></td>
                            <td>$@lote.CostoUnitarioLote.ToString("N2")</td>
                            <td>@lote.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (diasRestantes < 0)
                                {
                                    <span class="badge bg-danger">Vencido</span>
                                }
                                else if (diasRestantes <= 30)
                                {
                                    <span class="badge bg-warning text-dark">Por vencer (@diasRestantes días)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Vigente</span>
                                }
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@lote.LoteID" class="d-inline">
                                    <button type="submit" class="btn btn-light btn-sm text-danger" onclick="return confirm('¿Desea eliminar este registro de lote?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear Lote -->
<div class="modal fade" id="modalCrearLote" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Nuevo Lote de Insumos</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Producto</label>
                        <select asp-for="LoteForm.ProductoID" asp-items="Model.ProductosDrop" class="form-select" required>
                            <option value="">-- Seleccionar Producto --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Número / Código de Lote</label>
                        <input asp-for="LoteForm.NumeroLote" class="form-control" placeholder="Ej. LOT-2026-001" required />
                    </div>
                    <div class="row g-2">
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Costo Unitario</label>
                            <input type="number" step="0.01" asp-for="LoteForm.CostoUnitarioLote" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Fecha de Vencimiento</label>
                            <input type="date" asp-for="LoteForm.FechaVencimiento" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Guardar Lote</button>
                </div>
            </form>
        </div>
    </div>
</div>