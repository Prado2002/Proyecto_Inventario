@page
@model Inventario.Web.Pages.Productos.CreateModel
@{
    ViewData["Title"] = "Crear Producto";
}

<h2 class="mb-4">Registrar Nuevo Producto e Ingreso de Lote</h2>

<form method="post">
    <div class="card p-4 shadow-sm mb-4">
        <h4 class="card-title text-primary mb-3">1. Información del Producto</h4>
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Input.CodigoSKU" class="form-label">Código SKU</label>
                <input asp-for="Input.CodigoSKU" class="form-control" />
                <span asp-validation-for="Input.CodigoSKU" class="text-danger"></span>
            </div>
            
            <div class="col-md-6 mb-3">
                <label asp-for="Input.Nombre" class="form-label">Nombre del Producto</label>
                <input asp-for="Input.Nombre" class="form-control" />
                <span asp-validation-for="Input.Nombre" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Input.Descripcion" class="form-control" rows="2"></textarea>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Input.CostoPromedio" class="form-label">Costo Promedio ($)</label>
                <input asp-for="Input.CostoPromedio" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Input.PrecioVenta" class="form-label">Precio de Venta ($)</label>
                <input asp-for="Input.PrecioVenta" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Input.CategoriaID" class="form-label">Categoría</label>
                <select asp-for="Input.CategoriaID" class="form-select" asp-items="Model.Categorias">
                    <option value="">-- Seleccione Categoría --</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card p-4 shadow-sm mb-4">
        <h4 class="card-title text-success mb-3">2. Lote Inicial e Inventario</h4>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Input.NumeroLote" class="form-label">Número de Lote</label>
                <input asp-for="Input.NumeroLote" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Input.CantidadInicial" class="form-label">Cantidad Inicial</label>
                <input asp-for="Input.CantidadInicial" type="number" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Input.FechaVencimiento" class="form-label">Fecha Vencimiento</label>
                <input asp-for="Input.FechaVencimiento" type="date" class="form-control" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg">Guardar Producto y Stock</button>
    <a asp-page="./Index" class="btn btn-secondary btn-lg">Cancelar</a>
</form>