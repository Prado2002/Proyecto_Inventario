@page
@model Inventario.Web.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Productos</h3>
        <p class="text-muted small mb-0">Catálogo de productos e inventario</p>
    </div>
    <button class="btn btn-primary px-3 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalCrearProducto">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
    </button>
</div>

<div class="card table-custom shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Costo Prom.</th>
                    <th>Precio Venta</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.ProductosList.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No hay productos registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var prod in Model.ProductosList)
                    {
                        <tr>
                            <td><code>@prod.CodigoSKU</code></td>
                            <td class="fw-bold">@prod.Nombre</td>
                            <td><span class="badge bg-secondary-subtle text-dark border">@prod.CategoriaNombre</span></td>
                            <td>$@prod.CostoPromedio.ToString("N2")</td>
                            <td class="fw-bold text-success">$@prod.PrecioVenta.ToString("N2")</td>
                            <td class="text-end">
                                <button class="btn btn-light btn-sm text-primary me-1" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modalEditarProducto-@prod.ProductoID">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@prod.ProductoID" class="d-inline">
                                    <button type="submit" class="btn btn-light btn-sm text-danger" onclick="return confirm('¿Eliminar este producto?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>

                        <!-- Modal Editar Producto -->
                        <div class="modal fade" id="modalEditarProducto-@prod.ProductoID" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow">
                                    <form method="post" asp-page-handler="Edit">
                                        <input type="hidden" asp-for="ProductoForm.ProductoID" value="@prod.ProductoID" />
                                        <div class="modal-header bg-primary text-white">
                                            <h5 class="modal-title fw-bold">Editar Producto</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Categoría</label>
                                                <select name="ProductoForm.CategoriaID" class="form-select">
                                                    <option value="">-- Sin Categoría --</option>
                                                    @foreach (var cat in Model.CategoriasDrop)
                                                    {
                                                        if (cat.Value == prod.CategoriaID?.ToString())
                                                        {
                                                            <option value="@cat.Value" selected>@cat.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@cat.Value">@cat.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Código SKU</label>
                                                <input name="ProductoForm.CodigoSKU" value="@prod.CodigoSKU" class="form-control" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Nombre</label>
                                                <input name="ProductoForm.Nombre" value="@prod.Nombre" class="form-control" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Descripción</label>
                                                <textarea name="ProductoForm.Descripcion" class="form-control" rows="2">@prod.Descripcion</textarea>
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-6 mb-3">
                                                    <label class="form-label small fw-bold">Costo Promedio</label>
                                                    <input type="number" step="0.01" name="ProductoForm.CostoPromedio" value="@prod.CostoPromedio" class="form-control" required />
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <label class="form-label small fw-bold">Precio Venta</label>
                                                    <input type="number" step="0.01" name="ProductoForm.PrecioVenta" value="@prod.PrecioVenta" class="form-control" required />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light border-0">
                                            <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-primary px-4 rounded-3">Actualizar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear Producto -->
<div class="modal fade" id="modalCrearProducto" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Nuevo Producto</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Categoría</label>
                        <select asp-for="ProductoForm.CategoriaID" asp-items="Model.CategoriasDrop" class="form-select">
                            <option value="">-- Seleccionar Categoría (Opcional) --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Código SKU</label>
                        <input asp-for="ProductoForm.CodigoSKU" class="form-control" placeholder="Ej. PROD-001" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre</label>
                        <input asp-for="ProductoForm.Nombre" class="form-control" placeholder="Nombre del producto" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Descripción</label>
                        <textarea asp-for="ProductoForm.Descripcion" class="form-control" rows="2" placeholder="Detalles del producto"></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Costo Promedio</label>
                            <input type="number" step="0.01" asp-for="ProductoForm.CostoPromedio" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-bold">Precio Venta</label>
                            <input type="number" step="0.01" asp-for="ProductoForm.PrecioVenta" class="form-control" placeholder="0.00" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>